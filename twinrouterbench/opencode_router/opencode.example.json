{
  "$schema": "https://opencode.ai/config.json",
  "model": "twinrouter/auto",
  "small_model": "twinrouter/auto",
  "enabled_providers": ["twinrouter"],
  "provider": {
    "twinrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TwinRouterBench per-call router",
      "options": {"baseURL": "http://127.0.0.1:8787/v1", "apiKey": "local-router"},
      "models": {
        "auto": {
          "name": "Auto route each model call",
          "tool_call": true,
          "limit": {"context": 128000, "output": 8192}
        }
      }
    }
  }
}
